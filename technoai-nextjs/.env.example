# Copy to .env.local and fill in. Used to email Elementor form submissions (quote, newsletter, home page form).
# Hostinger email: host smtp.hostinger.com, port 465 (SSL). Use the mailbox's own address & password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown on the email (defaults to SMTP_USER)
MAIL_FROM=
# Who receives the submissions (comma-separated for several)
MAIL_TO=
